DATA SEGMENT

MSG1 DB 10,13,'ENTER THE STRING:$'
MSG2 DB 10,13,'STRING IS PALINDROME:$'
MSG3 DB 10,13,'STRING IS NOT PALINDROME:$'
STR1 DB 50 DUP(0)

DATA ENDS

CODE SEGMENT

//CS REFERS TO CODE SEGMET REGISTER AND DS REFERS TO DATA SEGMENT REGISTER
ASSUME CS:CODE,DS:DATA

START:
// DATA CONTAINS THE START ADRESS OF DATA SEGMENT WHICH WE GIVE TO DS REGISTER , WE CANNOT DO THAT DIRECTLY SO WE USE AN ACUMALATOR REGISTER AX FOR IT 
MOV AX,DATA
MOV DS,AX
// LEA MEANS LOADS EFFECTIVE OF MSG1 INTO DX 
LEA DX,MSG1
//AH=09H
// THESE TWO LINES ARE USED TO PRINT THE VALUE IN DX BY CONVENTION 
MOV AH,09H
// INT 21H GIVES ACESS TO DOS SERVICES
INT 21H

LEA S1,STR1
LEA D1,STR1
//USED TO READ SINGLE CHARACTER AT A TIME INPUTTED FROM KEYBOARD 
MOV AH, 01H

NEXT:
INT 21H
//0DH MEANS ENTER KEY
CMP AL ,0DH
//JE MEANS JUMP IF EQUAL
JE TERMINATE
MOV [D1],AL
INC D1
// JMP MEANS NO WHATEVR WHAT CALL NEXT LABEL
JMP NEXT

TERMINATE:
MOV AL,'$'
MOV [D1],AL

DOTHIS:
DEC D1
MOV AL,[S1]
CMP [D1],AL
JNE NOT PALINDROME

INC S1
CMP S1,D1
JL DOTHIS  

PALINDROME:
LEA DX,MSG2
MOV AH,09H
INT 21H
JMP XX

NOTPALINDROME:
LEA DX,MSG3
MOV AH,09H
INT 21H
JMP XX

XX:
// TERMINATE THE PROGRAM
MOV AH,4CH
INT 21H

CODE ENDS
END START


